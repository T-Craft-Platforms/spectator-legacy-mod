{
  "defaultModVersion": "0.1.0-dev",
  "requiredCapabilities": [
    "spectator",
    "camera",
    "inventory",
    "network",
    "hooks"
  ],
  "toolchains": {
    "forgegradle-1-java8-gradle3": {
      "java": "8",
      "gradle": "3.0",
      "versionArgument": "-PmodVersion={modVersion}",
      "commands": {
        "setup": [
          "gradle",
          "setupCIWorkspace",
          "--no-daemon"
        ],
        "build": [
          "gradle",
          "setupCIWorkspace",
          "build",
          "--no-daemon"
        ],
        "clean-build": [
          "gradle",
          "clean",
          "setupCIWorkspace",
          "build",
          "--no-daemon"
        ],
        "format": [
          "gradle",
          "formatJava",
          "--no-daemon"
        ]
      }
    },
    "voldeloom-2.4-java8-gradle7": {
      "java": "8",
      "versionArgument": "-PmodVersion={modVersion}",
      "prepare": "legacy-mappings",
      "commands": {
        "setup": [
          "java",
          "-cp",
          "../../toolchains/voldeloom/gradle-wrapper.jar",
          "org.gradle.wrapper.GradleWrapperMain",
          "help",
          "--no-daemon"
        ],
        "build": [
          "java",
          "-cp",
          "../../toolchains/voldeloom/gradle-wrapper.jar",
          "org.gradle.wrapper.GradleWrapperMain",
          "build",
          "--no-daemon"
        ],
        "clean-build": [
          "java",
          "-cp",
          "../../toolchains/voldeloom/gradle-wrapper.jar",
          "org.gradle.wrapper.GradleWrapperMain",
          "clean",
          "build",
          "--no-daemon"
        ],
        "format": [
          "java",
          "-cp",
          "../../toolchains/voldeloom/gradle-wrapper.jar",
          "org.gradle.wrapper.GradleWrapperMain",
          "formatJava",
          "--no-daemon"
        ]
      }
    }
  },
  "implementations": {
    "forge-fml-spectator": {
      "path": "implementations/forge-fml-spectator",
      "provides": [
        "spectator",
        "camera",
        "network"
      ],
      "compatibleTargets": [
        "1.6.2",
        "1.6.3",
        "1.6.4"
      ]
    },
    "fml-core-without-sorting-index": {
